# Runtime classification
APP_ENV=development
LOG_LEVEL=info

# Canonical URL for this environment. Preview OAuth uses the trusted incoming
# Vercel hostname only when it matches the project-owned *.vercel.app boundary.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Browser E2E fixture — CI/staging only, never commit real values.
E2E_BASE_URL=
E2E_STAGE3_EMAIL=
E2E_STAGE3_PASSWORD=
